# =============================================================================
# COD Compass — Git Ignore Configuration
# Protects private customer PII, local databases, secrets, and transient caches.
# =============================================================================

# 1. Private Real Customer Data — NEVER COMMIT REAL CUSTOMER INFORMATION
data/orders_sample.csv
data/*_sample.csv
data/*.private.csv
data/raw/
*.private.csv

# 2. Local Databases & SQLite Transients
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
cod_compass.db
backend/cod_compass.db
temp*.db

# 3. Environment Variables & Secrets
.env
.env.local
.env.*.local
.env.*
!.env.example
*.pem
*.key
*.cert
*.credentials

# 4. Logs & Private Diagnostic Output
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Node.js & Frontend Build Outputs
node_modules/
*/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
dist/

# 6. Python Environments, Bytecode & Packaging
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/
*/venv/
*/.venv/

# 7. Testing, Coverage & Playwright Reports
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.vitest_cache/
coverage/
playwright-report/
test-results/

# 8. OS & Editor Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# 9. Scratch & Temporary Files
scratch/
tmp/
temp/
*.tmp
*.zip
