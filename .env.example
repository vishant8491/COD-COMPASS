# COD Compass Configuration

# Optional: Server-side LLM provider key (OpenAI or Gemini)
# If omitted or left blank, COD Compass automatically runs in Offline Heuristic Mode
# with full natural language address completeness checks, Hinglish parsing, and an explicit UI badge.
GEMINI_API_KEY=
OPENAI_API_KEY=

# SQLite Database Location (defaults to cod_compass.db in project root)
DATABASE_PATH=cod_compass.db

# Server Port
PORT=8000

